  <model name='s2_advanced'>
    <pose>0 0 0 0 0 0</pose> <!-- Position of model inertial frame relative to gazebo inertial frame -->
<!-- Base link (Fuselage + Wings) -->
    <link name='base_link'>
      <!-- 0 0 0.115 0 0 0 -->
      <pose>0 0 0.115 0 0 0</pose> <!-- Position of S1 CG Frame relative to inertial frame. sitl flight controller is at base link origin. therefore CG should be at base link origin -->
      <inertial>
        <pose>0 0 0 0 0 0</pose> <!-- Position of inertia tensor relative to base_link frame (center of gravity) should be at base link origin -->
        <mass>24.0</mass>
        <inertia> <!-- Inertia characteristics of base_link -->
          <!-- Seems to be right. Check with structure/PD team-->
          <ixx>6.023</ixx>
          <ixy>0.014</ixy>
          <ixz>0.366</ixz>
          <iyy>10.405</iyy>
          <iyz>0.0</iyz>
          <izz>16.231</izz>
        </inertia>
      </inertial>
      <collision name='base_link_collision'> <!-- Collision geometry for base_link -->
        <pose>0 0 0 0 0 0</pose> <!-- Frame location of collision box relative to base_link frame -->
        <geometry>
          <box>
            <size>2.3 3.4 0.38</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <kp>100000</kp>
              <kd>1.0</kd>
              <max_vel>0.1</max_vel>
